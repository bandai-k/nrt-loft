# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored.

# Resend API key — https://resend.com/api-keys
# 1. Sign up at https://resend.com/
# 2. Create an API key with "Full access" (dev) or "Sending access" (prod)
RESEND_API_KEY=

# 問い合わせフォームの送信先アドレス
CONTACT_FORM_TO=hello@nebulab.jp

# LINE
# 公式アカウントの「友だち追加URL」と「表示ID(@xxx-xxxx)」
# クライアント側に露出するため NEXT_PUBLIC_ 接頭辞が必要
# 未設定の場合は LineContactCard のフォールバック値が使われます
NEXT_PUBLIC_LINE_FRIEND_URL=https://lin.ee/qtvP3Pt
NEXT_PUBLIC_LINE_DISPLAY_ID=@946tiavs
