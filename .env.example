# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored.

# Resend API key — https://resend.com/api-keys
# 1. Sign up at https://resend.com/
# 2. Create an API key with "Full access" (dev) or "Sending access" (prod)
RESEND_API_KEY=

# 問い合わせフォームの送信先アドレス
CONTACT_FORM_TO=hello@nebulab.jp

# ── 記事の管理画面 (/keystatic) ───────────────────────────
# 本番でブラウザから記事を書くには GitHub App が要る。
# 手元で `npm run dev` して http://localhost:3000/keystatic を開くと
# セットアップ画面が出るので、そこで GitHub App を作ると以下の3つが発行される。
# 発行された値を Vercel の環境変数にも登録し、あわせて
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github を入れると本番で書けるようになる。
# （未設定のあいだは手元のファイルを直接編集するモードで動く）
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_STORAGE=
